{
  "container_name": "example",
  "image_name":     "example",
  "restart":        "unless-stopped",
  "log_retention_days": 7,

  "tags": [],

  "base_image": "",

  "apps": [],

  "resources": {
    "cpus":        "1.0",
    "memory":      "512m",
    "pids_limit":  256
  },

  "health": {
    "interval":     "30s",
    "timeout":      "5s",
    "retries":      3,
    "start_period": "30s"
  },

  "network": {
    "network_name": "nelly_net",
    "subnet":  "192.168.20.0/24",
    "gateway": "192.168.20.1",
    "static_ip": "",
    "hostname": "",
    "ports": [],
    "extra_networks": [],
    "aliases": [],
    "dns": [],
    "extra_hosts": [],
    "labels": {}
  },

  "volumes": [],

  "hooks": {
    "pre_deploy":    "",
    "post_deploy":   "",
    "on_failure":    "",
    "pre_snapshot":  "",
    "post_snapshot": ""
  },

  "backup": {
    "skip_volumes": []
  },

  "packages": [
    "git",
    "libpq-dev",
    "gcc"
  ]
}
