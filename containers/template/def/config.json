{
  "container_name": "nelly-example",
  "image_name": "nelly-example",
  "log_retention_days": 7,

  "apps": [
    {
      "app_name": "hello",
      "git_url": "git@github.com:Jonatan-Gani/tamar_template.git",
      "ref": "main",
      "schedule": "*/5 * * * *",
      "entrypoint": "main.py"
    }
  ],

  "network": {
    "network_name": "nelly_net",
    "subnet": "192.168.20.0/24",
    "gateway": "192.168.20.1",
    "static_ip": "192.168.20.100",
    "ports": ["8080:80"]
  },

  "packages": [
    "git",
    "libpq-dev",
    "gcc"
  ]
}
