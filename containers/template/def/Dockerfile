FROM python:3.11-slim

ARG PROJECT_NAME=nelly
ENV PROJECT_NAME=$PROJECT_NAME \
    DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Base image deps: cron + tini for a clean PID 1.
RUN apt-get update \
 && apt-get install -y --no-install-recommends cron tini ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Extra OS packages declared in config.packages[] are injected here at build time.
# NELLY: SYSTEM_PACKAGES

# App layout
RUN mkdir -p /home/apps /opt/venvs /var/log/nelly
COPY apps /home/apps

# Per-app virtualenvs (one venv per app, isolated dependencies).
# These RUN lines are generated by lib/build.sh from each app's requirements.txt.
# NELLY: APP_VENVS

# Install the assembled crontab.
COPY crontab /etc/cron.d/nelly
RUN chmod 0644 /etc/cron.d/nelly \
 && crontab /etc/cron.d/nelly

# Run cron in the foreground under tini so signals are handled cleanly.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["cron", "-f", "-L", "15"]
