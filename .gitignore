# Per-deployment dirs under containers/ are user data — only ship the template.
/containers/*
!/containers/template/

# Inside the template, ship the scaffolding but not its runtime contents.
/containers/template/apps/*
/containers/template/logs/*
/containers/template/.build/
/containers/template/def/.env
/containers/template/def/commits.lock.json
/containers/template/def/last_image.txt

# Keep the empty folders around so a fresh clone has the layout.
!/containers/template/apps/.gitkeep
!/containers/template/logs/.gitkeep
