#!/usr/bin/env bash
# nelly — schedule Python jobs in Docker, painlessly.
#
# Single entry point. Dispatches subcommands to lib/*.sh.

set -euo pipefail

NELLY_VERSION="0.5.0"

NELLY_ROOT="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
export NELLY_ROOT
LIB="$NELLY_ROOT/lib"
# shellcheck source=../lib/common.sh
source "$LIB/common.sh"
# shellcheck source=../lib/hooks.sh
source "$LIB/hooks.sh"

NELLY_OUTPUT="${NELLY_OUTPUT:-human}"
INTERACTIVE=0
NELLY_YES=0
export NELLY_OUTPUT INTERACTIVE NELLY_YES

_bold() { [[ -t 1 ]] && printf '\033[1m%s\033[0m' "$1" || printf '%s' "$1"; }
_dim()  { [[ -t 1 ]] && printf '\033[2m%s\033[0m' "$1" || printf '%s' "$1"; }

# ----------------------------------------------------------------------------
# help text
# ----------------------------------------------------------------------------

intro() {
    cat <<EOF

$(_bold "nelly") v$NELLY_VERSION — schedule Python jobs in Docker, painlessly.

$(_bold "First time?")
  $(_bold "nelly init <name>")          $(_dim "# walks you through it (5 questions)")
  $(_bold "nelly deploy <name>")        $(_dim "# build and start the container")

$(_bold "Day-to-day")
  $(_bold "nelly list")                 $(_dim "# what deployments do I have?")
  $(_bold "nelly explain <name>")       $(_dim "# what does this deployment do?")
  $(_bold "nelly status  <name>")       $(_dim "# is it running? when last?")
  $(_bold "nelly logs    <name>")       $(_dim "# tail the cron logs")
  $(_bold "nelly shell   <name> --app <app>")  $(_dim "# drop into the app's venv inside the container")
  $(_bold "nelly cron    <name>")       $(_dim "# what's scheduled, in human terms")

$(_bold "Share / migrate / back up")
  $(_bold "nelly export <name>")        $(_dim "# dump deployment to JSON (no secrets by default)")
  $(_bold "nelly import <file>")        $(_dim "# create a deployment from a JSON export")
  $(_bold "nelly clone  <src> <dest>")  $(_dim "# fork an existing deployment")
  $(_bold "nelly backup <name>")        $(_dim "# tarball for disaster recovery")
  $(_bold "nelly snapshot create")      $(_dim "# build restore bundle at /var/backups/nelly (for restic et al.)")

$(_bold "Across many deployments")
  $(_bold "nelly all list")             $(_dim "# tag-aware listing")
  $(_bold "nelly all deploy --tag prod") $(_dim "# act on a group")

$(_bold "Monitor from your phone")
  $(_bold "nelly bot setup")            $(_dim "# wire up a Telegram bot (allow-listed users only)")

$(_bold "Stay current")
  $(_bold "nelly update")               $(_dim "# pull latest, smoke-test, restart bot + redeploy as needed")
  $(_bold "nelly check-updates")        $(_dim "# is the upstream branch ahead? (--notify pings the bot)")

$(_bold "Prefer to edit config.json directly?") That's also fine — config is the source of truth.
  $(_bold "nelly edit    <name>")       $(_dim "# opens \$EDITOR; validates on save")
  $(_bold "nelly plan    <name>")       $(_dim "# show what deploy will do, no side effects")

$(_bold "Full reference:")   $(_bold "nelly help")
$(_bold "One command:")      $(_bold "nelly help <command>")
EOF
}

usage_full() {
    cat <<EOF

$(_bold "nelly") v$NELLY_VERSION <command> [args...] [--json] [-i|--interactive] [-y|--yes]

$(_bold "GET STARTED")
  init       <name> [--from FILE]       Scaffold a new deployment (wizard, or from an export file)
  explain    <name>                     Plain-English summary
  doctor     <name>                     Pre-flight checks before deploying
  plan       <name>                     What would deploy do? (no side effects)

$(_bold "DEPLOY / UPDATE")
  deploy     <name> [--wait-healthy N] [--auto-rollback]
                                         fetch → build → run → verify → prune
  fetch      <name>                     Refresh sources + lockfile
  build      <name> [--dry-run]         Build image (or render Dockerfile)
  run        <name> [--wait-healthy N] [--auto-rollback]
                                         (Re)start container
  rollback   <name> [--to TAG|--list]   Switch to a previous build
  diff       <name>                     What would change on next fetch?
  push       <name> <app> <src> [dst]   Hot-copy a file into a running app

$(_bold "MANAGE APPS")  $(_dim "(an 'app' = one scheduled Python script)")
  app add        <name> [flags or wizard]    Add an app
  app list       <name>
  app show       <name> <app>
  app remove     <name> <app>
  app schedule   <name> <app> "<cron>"
  app ref        <name> <app> <git-ref>
  app path       <name> <app> <local-path>

$(_bold "MANAGE CONFIG")  $(_dim "(config.json is the source of truth)")
  edit       <name>                     Open def/config.json in \$EDITOR
  show       <name>                     Print the full config
  get        <name> <jq-path>           Read one value
  set        <name> <jq-path> <value>   Write one value (atomic + validating)
  validate   <name>
  tag        <name> add|remove|list TAG...

$(_bold "MANAGE SECRETS")  $(_dim "(def/.env global + def/secrets/<app>.env per-app, all mode 0600)")
  secrets set      <name> [--app APP] KEY=value [...]
  secrets unset    <name> [--app APP] KEY [...]
  secrets list     <name> [--app APP]        keys only — never values
  secrets edit     <name> [--app APP]
  secrets template <name>                    skeleton from legacy config refs

$(_bold "LIFECYCLE")
  start      <name>                     docker start
  stop       <name>                     docker stop
  restart    <name>                     docker restart
  exec       <name> -- <cmd...>         Run a command inside the container
  shell      <name> [--app <app>]       Drop into a shell (in the app's venv if --app)
  attach     <name>                     Attach to the container's stdout
  run-now    <name> <app>               Trigger an app immediately, outside cron
  top        <name>                     Processes running inside the container
  inspect    <name>                     Resources / image / health / networks

$(_bold "OBSERVE")
  list                                  All deployments + state   (alias: ls)
  ps                                    docker ps over nelly-managed containers
  stats                                 Live cpu / memory / pids
  status     <name>                     One deployment's state + pinned commits
  logs       <name> [app]               Tail container logs
  events     <name> [--since DUR]       Stream docker events for the container
  cron       <name> [--next N]          What's scheduled, in human terms
  metrics    <name> [--app A] [--since DUR] [--release REL]
                                         Per-app run metrics (count, success, p95)
  prune      <name>                     Delete old log files

$(_bold "RELEASES")  $(_dim "(every deploy is a tracked, revertable record)")
  release list     <name>                       Recent releases
  release show     <name> [rel_id]              Manifest (default: latest)
  release diff     <name> <rel_a> <rel_b>       Config diff between two releases
  release restore  <name> <rel_id> [--image-only|--config-only]
                                                 Revert config + image atomically
  release note     <name> <rel_id> "<text>"     Annotate a release
  release prune    <name> [--keep N]            Trim retention (default 50)

$(_bold "IMAGE MANAGEMENT")  $(_dim "(disk hygiene + reproducible bases)")
  image-prune     <name> [--keep N] [--dry-run]
                                                 Remove old Docker images for this deployment.
                                                 Always keeps :latest + running + last N
                                                 successful (default N=2). Auto-runs on
                                                 successful deploy.
  base-image-pin  <name> [<image:tag>]          Resolve a tag to its current @sha256:... and
                                                 write to .base_image (reproducible base).

$(_bold "SHARE / MIGRATE / BACK UP")
  export     <name> [--include-secrets] [--include-lockfile]
                                         Dump deployment to JSON (stdout)
  import     <file|-> [--as <name>] [--force]
                                         Create a deployment from an export
  clone      <src> <dest>               Fork an existing deployment
  backup     <name> [--out PATH] [--include-logs]
                                         Tarball of the deployment dir
  restore    <tarball> [--as <name>] [--force]
  snapshot   create|verify|list|install-hook
                                         Build / inspect the fleet-wide restore bundle
                                         at /var/backups/nelly for off-site backup tools.

$(_bold "ACROSS MANY DEPLOYMENTS")
  all <cmd>  [--tag T]... [--fail-fast]
                                         Run <cmd> against every matching deployment
  all list                              Tag-aware deployment list

$(_bold "TELEGRAM BOT")  $(_dim "(secure remote monitoring + lifecycle from your phone)")
  bot setup                             Interactive: token, allowed users, write flag
  bot start                             Run the bot daemon (foreground)
  bot status                            Is it running? + recent activity
  bot notify <message>                  One-shot push to allowed users (use in hooks)
  bot test                              Send a "hello" to confirm wiring
  bot allow|revoke <user_id>            Manage the allowed-users list
  bot install-systemd                   Install a user systemd unit

$(_bold "MAINTENANCE")
  update          [--check]             Pull latest Nelly, smoke-test, restart bot + redeploy
                                         as needed (one command for the whole upgrade)
  check-updates   [check|status|install-timer|uninstall-timer]
                                         Watch the upstream branch; with --notify, ping the
                                         Telegram bot when there's a new commit. install-timer
                                         enables a systemd --user timer that does this hourly.

$(_bold "GLOBAL FLAGS")
  --json                   machine-readable output where supported
  -i, --interactive        prompt before destructive ops
  -y, --yes                never prompt; accept wizard defaults
  --version                print nelly version
  -h, --help               this help, or 'nelly help <command>'

$(_bold "ENVIRONMENT")
  EDITOR                   used by 'edit' / 'secrets edit'
  NELLY_OUTPUT=json        same as --json
  NELLY_YES=1              same as --yes

For detail on any command: $(_bold "nelly help <command>")
EOF
}

cmd_help() {
    case "${1:-}" in
        ""|help) usage_full ;;

        init)
            cat <<EOF
$(_bold "nelly init <name> [--from FILE]")

Scaffold a new deployment. Without --from, runs an interactive wizard.
With --from, loads the config from an export file (skipping the wizard):

  nelly export prod > prod.json
  scp prod.json other-host:
  nelly init prod --from prod.json -y

Add -y to skip optional wizard steps (no app, no secrets) — useful when you
plan to follow up with \`nelly edit\` or \`nelly app add\`.
EOF
            ;;

        deploy)
            cat <<EOF
$(_bold "nelly deploy <name> [--wait-healthy N] [--auto-rollback]")

The full pipeline:
  1. pre_deploy hook (if configured)
  2. fetch — clone or rsync each app, pin revs
  3. build — render Dockerfile + crontab, tag image with lockfile hash
  4. run   — (re)start container with limits, healthcheck, secrets
  5. (optional) wait up to N seconds for healthcheck to pass
       --auto-rollback: on failure, switch back to the previous image tag
  6. post_deploy hook (if healthy) — or — on_failure hook (otherwise)
  7. prune logs older than log_retention_days

\`nelly deploy\` is non-interactive and exits non-zero on any failure, so
it's safe in cron / CI.
EOF
            ;;

        app) cat <<EOF
$(_bold "nelly app <sub> <name> ...")
   app add        <name>                          interactive wizard
   app add        <name> --name N --git URL --schedule "..." --entrypoint FILE
   app list       <name>
   app show       <name> <app>
   app remove     <name> <app>
   app schedule   <name> <app> "<cron>"
   app ref        <name> <app> <git-ref>           (git sources only)
   app path       <name> <app> <local-path>        (local sources only)
EOF
            ;;

        shell) cat <<EOF
$(_bold "nelly shell <name> [--app <app>]")

Drop into a bash inside the container.

With --app <app>:
  - cwd is /home/apps/<app>
  - PATH is prefixed with /opt/venvs/<app>/bin (so 'python', 'pip' point at
    that app's virtualenv)
  - VIRTUAL_ENV and NELLY_APP are set
EOF
            ;;

        export)
            cat <<EOF
$(_bold "nelly export <name> [--include-secrets] [--include-lockfile]")

Print a self-contained JSON description of the deployment to stdout. Pipe
it to a file, version-control it, mail it, whatever.

Secrets are EXCLUDED by default. Pass --include-secrets to embed a base64
copy of def/.env (handle the result like a password). --include-lockfile
pins the exact commits, which is useful for true bit-for-bit reproduction
on another host.

Use \`nelly import\` to materialise an export on another host.
EOF
            ;;

        backup) cat <<EOF
$(_bold "nelly backup <name> [--out PATH] [--include-logs]")
$(_bold "nelly restore <tarball> [--as <name>] [--force]")

backup  → tarball of the deployment directory (config + secrets + lockfile
          + build history + Dockerfile). Excludes apps/ (re-fetched) and
          logs/ (re-created). Pass --include-logs to keep them.

restore → recreate a deployment from a tarball, optionally under a new
          name. The deployment is ready to run \`nelly deploy\`.
EOF
            ;;

        snapshot) cat <<EOF
$(_bold "nelly snapshot <sub> ...")

Produces a fleet-wide restore bundle for the off-site backup layer (restic,
borg, etc.) to walk. The bundle is the contract: everything required to
reconstruct every container nelly manages on a freshly flashed host —
images, volumes, secrets — in one declared directory, in a consistent state.

Default output: $(_bold "/var/backups/nelly") (override with --out or NELLY_BACKUP_DIR).

    snapshot create   [--out DIR] [--no-quiesce] [--no-volumes] [--no-secrets]
                      [--exclude NAME]... [--only NAME]... [--quiesce-time N]
                      [--no-verify]
                      Build the bundle. Per deployment: snapshot tarball
                      (config + secrets + lockfile + releases), docker
                      inspect, image digest pin, and a quiesced tar of each
                      declared bind-mount volume. Atomically swaps in. Self-
                      verifies on completion and exits non-zero if the
                      bundle is bad — so a broken snapshot trips the backup
                      runner's hard-fail tonight, not at restore time.
                      hooks.pre_snapshot runs BEFORE quiesce (drop pg_dump
                      / mysqldump output into \$NELLY_SNAPSHOT_DIR/dumps/).
                      Volumes listed in .backup.skip_volumes are NOT also
                      quiesce-tarred (so a logical dump and an on-disk copy
                      of the same DB don't both ship).

    snapshot verify   [--out DIR]
                      Structural check: BUNDLE_VERSION, JSON validity of
                      fleet-manifest.json, presence of per-deployment
                      tarballs, sha256 of each volume tarball matches its
                      .meta.json.

    snapshot list     [--out DIR]
                      Print metadata from the most recent run: when, host,
                      duration, size, per-deployment success/failure.

    snapshot install-hook   [--hook-dir DIR] [--name NAME]
                      Drop a tiny pre-backup hook script into a run-parts
                      dir (default $(_bold "/etc/restic/pre-backup.d/")) so the
                      bundle is regenerated synchronously before each
                      off-site run. Avoids the timing-fragile "nelly on its
                      own timer" pattern.

    snapshot uninstall-hook [--hook-dir DIR] [--name NAME]

$(_bold "Exit codes (create):")  0 bundle complete and verified · 1 one or more
    deployments failed · 3 bundle failed self-verify. The installed hook is
    strict-mode, so any non-zero aborts the off-site backup run.

$(_bold "Bundle layout (at \$OUT, mode 0700):")
    BUNDLE_VERSION            schema version ("1")
    README.txt                restore steps
    snapshot.log              full log of the run that built this bundle
    snapshot.json             generation metadata + per-deployment results
    fleet-manifest.json       images, digests, ports, networks, volumes,
                              env-file paths, app commits
    deployments/<name>/
        tarball.tar           full deployment dir incl. secrets
                              (uncompressed + deterministic for restic dedup)
        container-inspect.json
        image-digest.txt      image@sha256:...
        volumes/<slug>.tar    quiesced tar of each bind-mount (uncompressed)
        volumes/<slug>.meta.json
        volumes/skipped-volumes.json   volumes covered by hooks.pre_snapshot
        dumps/                where hooks.pre_snapshot drops DB dumps
    nelly-state/
        bot.tar               Telegram bot state if present
        nelly-commit.txt      git HEAD of nelly itself
EOF
            ;;

        all) cat <<EOF
$(_bold "nelly all <cmd> [--tag T]... [--fail-fast] [-- <cmd args>...]")

Run a nelly command against every matching deployment. --tag filters can
be repeated and are AND-ed: only deployments whose config.tags[] contains
all given tags are included.

Examples:
  nelly all list
  nelly all status                          # status of every deployment
  nelly all deploy --tag prod               # deploy all prod deployments
  nelly all restart --tag prod --tag critical
  nelly all -- --json status                # passes --json to each invocation
EOF
            ;;

        tag) cat <<EOF
$(_bold "nelly tag <name> <add|remove|list> [TAG...]")

Tags are arbitrary strings (e.g. "prod", "critical", "team-a"). They're
visible in \`nelly list\`, the docker label nelly.tags, and used by
\`nelly all --tag\`.
EOF
            ;;

        rollback) cat <<EOF
$(_bold "nelly rollback <name>")
   nelly rollback <name>              switch to the previous image
   nelly rollback <name> --to TAG     switch to a specific image
   nelly rollback <name> --list       show recent builds
EOF
            ;;

        update) cat <<EOF
$(_bold "nelly update [--check]")

One-shot upgrade of Nelly itself. Does, in order:

   1. git fetch + show new commits / changed files
   2. git pull (--ff-only — fails clean if it can't fast-forward)
   3. run tests/smoke.sh as a sanity check; abort if it fails, with
      instructions to revert
   4. restart the Telegram bot daemon if lib/bot.* changed AND
      the systemd user unit is currently active
   5. redeploy every deployment if lib/build.sh / source.sh / the
      template Dockerfile changed (these affect image content)
   6. otherwise re-run every container if lib/run.sh / manage.sh /
      hooks.sh / secrets.sh changed (no rebuild needed)

Steps 4-6 prompt before acting; pass -y to skip the prompts. --check
prints what would happen without applying anything.

Examples:
   $(_bold 'nelly update')              # interactive (prompts before each step)
   $(_bold 'nelly -y update')           # do everything without asking
   $(_bold 'nelly update --check')      # show plan, change nothing
EOF
            ;;
        check-updates) cat <<EOF
$(_bold "nelly check-updates <sub> ...")

Polls the upstream branch for new commits and, optionally, pings the Telegram
bot so the operator can decide whether to apply them. The bot exposes
/update_check (preview) and /update (apply) for the response side.

   check                       Print status. Exit 0 if up-to-date, 1 if
                               behind, 2 on error (network, no upstream).
   check --notify              Same, plus send ONE Telegram message if
                               behind. Idempotent — the same SHA is not
                               re-notified on every tick.
   check --branch NAME         Watch a different branch than the one
                               checked out. (NELLY_UPDATE_BRANCH env var
                               also works.) Note: \`nelly update\` still
                               pulls the currently-checked-out branch, so
                               only override if you'll switch first.
   install-timer [--every D]   Install a systemd --user timer that runs
                               \`check --notify\` on a schedule (default 1h).
   uninstall-timer
   status                      Show timer state + last-notified SHA.

State file: $(_bold "\$NELLY_ROOT/.update-check.state")  (one line, the last-notified SHA)
EOF
            ;;
        bot) cat <<EOF
$(_bold "nelly bot <sub> ...")

Telegram bot for monitoring + lifecycle from your phone.

   bot setup                  Interactive setup. Asks for the token (from
                              @BotFather), auto-detects your user id when you
                              message the bot, optionally enables write
                              commands (start/stop/deploy/rollback).
   bot start                  Run the bot daemon in the foreground.
   bot install-systemd        Generate a user systemd unit so it survives
                              reboot and restarts on crash.
   bot status                 Is it running? Recent activity.
   bot notify <message>       Push a message to all allowed users from
                              anywhere — perfect for deploy hooks:
                                  config.hooks.post_deploy =
                                  './def/hooks/notify.sh'
                                  # contents: nelly bot notify "✅ \$NELLY_DEPLOYMENT"
   bot test                   Send a hello to verify wiring.
   bot allow  <user_id>       Add a user to the allow-list.
   bot revoke <user_id>       Remove a user.

Security: token is mode-0600, only user IDs in allowed_users get any reply,
unknown users are silently dropped, write commands are gated on
allow_writes:true in bot/config.json, every command is audit-logged to
bot/bot.log.
EOF
            ;;
        release|releases) cat <<EOF
$(_bold "nelly release <sub> <name> ...")

Every \`nelly deploy\` records a release: image tag, full config snapshot,
commit pins, outcome, duration, health status, actor. Releases are the unit
of revert — you can roll back code AND configuration to any prior state.

   release list     <name>                       table of recent releases
   release show     <name> [rel_id]              full manifest (default: latest)
   release diff     <name> <rel_a> <rel_b>       unified config diff
   release restore  <name> <rel_id>              revert config + switch image
                                                  (writes a NEW release that
                                                  records the rollback)
   release restore  <name> <rel_id> --image-only   image only, keep current config
   release restore  <name> <rel_id> --config-only  config only, keep current image
   release note     <name> <rel_id> "text"
   release prune    <name> [--keep N]            default keep 50

Releases live at: containers/<name>/def/releases/<rel_id>/
                    manifest.json, config.json, commits.lock.json,
                    build.log, run.log
EOF
            ;;
        metrics) cat <<EOF
$(_bold "nelly metrics <name> [--app A] [--since DUR] [--release REL]")

Per-app run metrics aggregated from /var/log/nelly/<app>.metrics.jsonl
(produced by the in-container nelly-run wrapper).

Columns: RUNS, OK, FAIL, AVG(s), P95(s), LAST timestamp, LAST exit code.

   --app A         restrict to one app
   --since DUR     30m, 24h, 7d, ...
   --release REL   restrict to a release's time window
   --json          machine-readable

Examples:
   nelly metrics scraper                       # all-time
   nelly metrics scraper --since 24h           # last day
   nelly metrics scraper --app fetcher
   nelly metrics scraper --release r-0042      # how did r-0042 perform?
EOF
            ;;
        cron) echo "nelly cron <name> [--next N]: print the assembled crontab in human-readable form. --next N adds the next N run times per app (requires python3 on the host)." ;;
        events) echo "nelly events <name> [--since DURATION]: stream docker events for the container. Ctrl-C to stop." ;;
        plan)   echo "nelly plan <name>: print what 'nelly deploy' would do, with no side effects." ;;
        diff)   echo "nelly diff <name>: git ls-remote each git source, compare against the lockfile, show what would change." ;;
        explain) echo "nelly explain <name>: plain-English summary of what the deployment will do." ;;
        doctor)  echo "nelly doctor <name>: pre-flight checks — config valid, sources reachable, docker running, secrets present, …" ;;
        run-now) echo "nelly run-now <name> <app>: run the app's entrypoint immediately inside the container, outside cron." ;;
        push)    echo "nelly push <name> <app> <src> [dst]: docker cp into a running app. Ephemeral until next deploy." ;;
        attach)  echo "nelly attach <name>: attach to the container's stdout. Ctrl-p Ctrl-q to detach without killing." ;;

        *) echo "no extra help for '$1'. See: nelly help" ;;
    esac
}

# ----------------------------------------------------------------------------
# argument parsing — global flags can appear anywhere
# ----------------------------------------------------------------------------

declare -a ARGS=()
SAW_HELP=0
while (( $# > 0 )); do
    case "$1" in
        --json)            NELLY_OUTPUT="json"; export NELLY_OUTPUT; shift ;;
        -i|--interactive)  INTERACTIVE=1; NELLY_YES=0; export INTERACTIVE NELLY_YES; shift ;;
        -y|--yes)          NELLY_YES=1; INTERACTIVE=0; export NELLY_YES INTERACTIVE; shift ;;
        --version)         echo "nelly $NELLY_VERSION"; exit 0 ;;
        -h|--help)         SAW_HELP=1; shift ;;
        help)              shift; cmd_help "${1:-}"; exit 0 ;;
        --)                shift; ARGS+=("$@"); break ;;
        *)                 ARGS+=("$1"); shift ;;
    esac
done
set -- "${ARGS[@]:-}"

if (( SAW_HELP )); then
    cmd_help "${1:-}"
    exit 0
fi

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
    intro
    exit 0
fi
shift || true

_deploy_dir() {
    local n="${1:-}"
    [[ -n "$n" ]] || die "missing <name> (try: nelly list)"
    local d="$NELLY_ROOT/containers/$n"
    [[ -d "$d" ]] || die "no such deployment: $n (try: nelly init $n)"
    printf '%s' "$d"
}

# Wrap the full deploy pipeline including hooks + optional wait/rollback.
_run_deploy() {
    local d="$1"; shift
    local wait_seconds="" auto_rollback=0
    declare -a pass_through=()
    while (( $# > 0 )); do
        case "$1" in
            --wait-healthy)
                [[ "${2:-}" =~ ^[0-9]+$ ]] || die "--wait-healthy needs an integer (seconds), got: ${2:-}"
                wait_seconds="$2"; shift 2 ;;
            --auto-rollback) auto_rollback=1; shift ;;
            *) pass_through+=("$1"); shift ;;
        esac
    done

    # Run the lifecycle in a locked subshell. The script body is fixed and
    # single-quoted; every value arrives as a positional parameter ($1=deploy
    # dir, $2=lib dir, $3=wait seconds, $4=auto-rollback 0|1, $5..=build args).
    # Nothing is interpolated into the program text, so no config value or CLI
    # arg can alter what executes.
    with_lock "$d" bash -c '
        set -e
        d="$1"; lib="$2"; wait_seconds="$3"; auto_rollback="$4"; shift 4
        build_args=( "$@" )

        rel_id="$("$lib/release.sh" create "$d")"
        export NELLY_RELEASE_ID="$rel_id"

        # On any unhandled error before finalize, mark the release failed so it
        # is not left "pending" forever.
        _fail() { "$lib/release.sh" finalize "$d" "$rel_id" --outcome failed || true; }
        trap _fail ERR

        "$lib/hooks.sh" "$d" pre_deploy
        "$lib/fetch.sh" "$d"
        "$lib/build.sh" "$d" "${build_args[@]}"

        run_args=( "$d" )
        [ -n "$wait_seconds" ] && run_args+=( --wait-healthy "$wait_seconds" )
        [ "$auto_rollback" = 1 ] && run_args+=( --auto-rollback )

        if "$lib/run.sh" "${run_args[@]}"; then
            trap - ERR
            health="$(docker inspect -f "{{.State.Health.Status}}" \
                "$(jq -r .container_name "$d/def/config.json")" 2>/dev/null || echo n/a)"
            fin_args=( "$d" "$rel_id" --outcome success --health "$health" )
            [ -n "$wait_seconds" ] && fin_args+=( --wait-healthy "$wait_seconds" )
            "$lib/release.sh" finalize "${fin_args[@]}"
            "$lib/hooks.sh" "$d" post_deploy || true
            "$lib/prune.sh" "$d" || true
            # Auto-prune old images so disk does not grow without bound.
            "$lib/image-prune.sh" "$d" || true
        else
            rc=$?
            trap - ERR
            "$lib/release.sh" finalize "$d" "$rel_id" --outcome failed || true
            "$lib/hooks.sh" "$d" on_failure || true
            exit "$rc"
        fi
    ' _ "$d" "$LIB" "$wait_seconds" "$auto_rollback" "${pass_through[@]}"
    info "deploy complete: $(basename "$d")"
}

# ----------------------------------------------------------------------------
# dispatch
# ----------------------------------------------------------------------------

case "$cmd" in

    # ---- onboarding ----------------------------------------------------
    init)
        name="${1:-}"; shift || true
        [[ -n "$name" ]] || die "usage: nelly init <name> [--from FILE]"
        dest="$NELLY_ROOT/containers/$name"
        [[ -e "$dest" ]] && die "already exists: $dest  (use: nelly edit $name)"
        [[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$ ]] \
            || die "invalid name '$name'; use [a-zA-Z0-9_.-] starting with a letter/digit"

        FROM=""
        while (( $# > 0 )); do
            case "$1" in
                --from) FROM="$2"; shift 2 ;;
                *) shift ;;
            esac
        done

        if [[ -n "$FROM" ]]; then
            "$LIB/portable.sh" init-from "$FROM" "$name"
        else
            cp -r "$NELLY_ROOT/containers/template" "$dest"
            "$LIB/wizard.sh" init "$dest"
        fi
        ;;

    explain)  "$LIB/explain.sh" "$(_deploy_dir "${1:-}")" ;;
    doctor)   "$LIB/doctor.sh"  "$(_deploy_dir "${1:-}")" ;;
    plan)     "$LIB/plan.sh"    "$(_deploy_dir "${1:-}")" ;;

    # ---- observation ---------------------------------------------------
    list|ls)  "$LIB/list.sh" ;;
    ps)       "$LIB/stats.sh" ps ;;
    stats)    "$LIB/stats.sh" stats ;;
    status)   "$LIB/status.sh" "$(_deploy_dir "${1:-}")" ;;
    logs)
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/logs.sh" "$d" "${1:-}" ;;
    events)
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/events.sh" "$d" "$@" ;;
    cron)
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/cron.sh" "$d" "$@" ;;

    # ---- app subcommands ----------------------------------------------
    app)
        sub="${1:-}"; shift || true
        [[ -n "$sub" ]] || { cmd_help app; exit 2; }
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/app.sh" "$sub" "$d" "$@" ;;
    add-app)
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/app.sh" add "$d" "$@" ;;
    remove-app)
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/app.sh" remove "$d" "$@" ;;
    set-schedule)
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/app.sh" schedule "$d" "$@" ;;

    # ---- tags ---------------------------------------------------------
    tag)
        d="$(_deploy_dir "${1:-}")"; shift || true
        sub="${1:-}"; shift || true
        [[ -n "$sub" ]] || die "usage: nelly tag <name> <add|remove|list> [TAG...]"
        case "$sub" in
            add)    "$LIB/config.sh" tags-add    "$d" "$@" ;;
            remove) "$LIB/config.sh" tags-remove "$d" "$@" ;;
            list)   "$LIB/config.sh" tags-list   "$d" ;;
            *) die "tag sub must be add|remove|list" ;;
        esac
        ;;

    # ---- config --------------------------------------------------------
    show|get|set|edit|validate)
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/config.sh" "$cmd" "$d" "$@" ;;

    # ---- secrets -------------------------------------------------------
    secrets|secret)
        sub="${1:-}"; shift || true
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/secrets.sh" "$sub" "$d" "$@" ;;

    # ---- deploy / build / run ----------------------------------------
    deploy)
        d="$(_deploy_dir "${1:-}")"; shift || true
        _run_deploy "$d" "$@" ;;
    fetch)    d="$(_deploy_dir "${1:-}")"; shift || true; with_lock "$d" "$LIB/fetch.sh"    "$d" "$@" ;;
    build)    d="$(_deploy_dir "${1:-}")"; shift || true; with_lock "$d" "$LIB/build.sh"    "$d" "$@" ;;
    run)      d="$(_deploy_dir "${1:-}")"; shift || true; with_lock "$d" "$LIB/run.sh"      "$d" "$@" ;;
    rollback) d="$(_deploy_dir "${1:-}")"; shift || true; with_lock "$d" "$LIB/rollback.sh" "$d" "$@" ;;
    diff)     d="$(_deploy_dir "${1:-}")"; shift || true; "$LIB/diff.sh"  "$d" "$@" ;;
    prune)    d="$(_deploy_dir "${1:-}")"; shift || true; "$LIB/prune.sh" "$d" "$@" ;;
    push)     d="$(_deploy_dir "${1:-}")"; shift || true; "$LIB/push.sh"  "$d" "$@" ;;

    # ---- lifecycle -----------------------------------------------------
    start|stop|restart)
        # Mutating lifecycle ops serialize against an in-flight deploy.
        d="$(_deploy_dir "${1:-}")"; shift || true
        with_lock "$d" "$LIB/manage.sh" "$cmd" "$d" "$@" ;;
    exec|shell|attach|inspect|top)
        # Read-only / interactive — exec/shell/attach replace the process via
        # `exec docker`, so they must NOT hold the lock.
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/manage.sh" "$cmd" "$d" "$@" ;;
    run-now)
        # Runs a job inside the live container; lock so a deploy can't swap the
        # container out mid-run.
        d="$(_deploy_dir "${1:-}")"; shift || true
        with_lock "$d" "$LIB/manage.sh" run-now "$d" "$@" ;;

    # ---- portable / backup ---------------------------------------------
    export)
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/portable.sh" export "$d" "$@" ;;
    import)
        "$LIB/portable.sh" import "$@" ;;
    clone)
        src="${1:-}"; dest="${2:-}"
        [[ -n "$src" && -n "$dest" ]] || die "usage: nelly clone <src> <dest>"
        sd="$(_deploy_dir "$src")"
        "$LIB/portable.sh" clone "$sd" "$dest" ;;
    backup)
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/backup.sh" backup "$d" "$@" ;;
    restore)
        "$LIB/backup.sh" restore "$@" ;;

    # ---- fleet-wide restore bundle (for restic / borg / ...) -----------
    snapshot)
        # No-arg default is HELP, not create: bare `nelly snapshot` must not
        # quiesce (stop/start) every container as a side effect of a typo.
        sub="${1:-help}"; shift || true
        case "$sub" in
            create|verify|list|ls|status|install-hook|uninstall-hook|help|-h|--help|"")
                "$LIB/snapshot.sh" "$sub" "$@" ;;
            *) err "unknown snapshot sub: $sub"; echo "Try: nelly help snapshot" >&2; exit 2 ;;
        esac ;;

    # ---- across many deployments --------------------------------------
    all)
        "$LIB/all.sh" "$@" ;;

    # ---- releases (version control for deployed config + image) -------
    release|releases)
        sub="${1:-list}"; shift || true
        case "$sub" in
            list|ls) d="$(_deploy_dir "${1:-}")"; "$LIB/release.sh" list "$d" ;;
            show)    d="$(_deploy_dir "${1:-}")"; shift || true
                     "$LIB/release.sh" show "$d" "${1:-}" ;;
            diff)    d="$(_deploy_dir "${1:-}")"; shift || true
                     "$LIB/release.sh" diff "$d" "${1:-}" "${2:-}" ;;
            restore|revert)
                     # Mutates config + swaps the image + writes release
                     # records — serialize against an in-flight deploy.
                     d="$(_deploy_dir "${1:-}")"; shift || true
                     with_lock "$d" "$LIB/release.sh" restore "$d" "$@" ;;
            note)    d="$(_deploy_dir "${1:-}")"; shift || true
                     "$LIB/release.sh" note "$d" "$@" ;;
            prune)   d="$(_deploy_dir "${1:-}")"; shift || true
                     "$LIB/release.sh" prune "$d" "$@" ;;
            *) err "unknown release sub: $sub"; echo "Try: nelly help release" >&2; exit 2 ;;
        esac
        ;;

    metrics)
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/metrics.sh" "$d" "$@" ;;

    # ---- image management ---------------------------------------------
    image-prune)
        d="$(_deploy_dir "${1:-}")"; shift || true
        "$LIB/image-prune.sh" "$d" "$@" ;;

    base-image-pin)
        # nelly base-image-pin <name> [<image:tag>]
        # Resolves the (optionally-named) image to its current sha256 digest
        # and writes it to .base_image in the config. Use this whenever you
        # consciously want to refresh the OS base layer.
        d="$(_deploy_dir "${1:-}")"; shift || true
        TAG="${1:-}"
        if [[ -z "$TAG" ]]; then
            # Try to read the existing tag (without digest) from config; else
            # fall back to the Dockerfile's FROM line; else python:3.11-slim.
            TAG="$("$LIB/config.sh" get "$d" '.base_image' 2>/dev/null | sed 's/@sha256:.*//' || true)"
            [[ -z "$TAG" || "$TAG" == "null" ]] \
                && TAG="$(awk 'NR==1 && /^FROM / {print $2; exit}' "$d/def/Dockerfile" 2>/dev/null || echo python:3.11-slim)"
        fi
        require_cmd docker
        info "pulling $TAG to read its digest"
        docker pull -q -- "$TAG" >/dev/null
        # RepoDigests looks like ["python@sha256:abc..."]. Extract the digest part.
        DIG="$(docker inspect "$TAG" --format '{{index .RepoDigests 0}}' 2>/dev/null || true)"
        [[ -n "$DIG" && "$DIG" == *@sha256:* ]] || die "could not resolve digest for $TAG"
        PINNED="${TAG%%:*}:${TAG##*:}@${DIG##*@}"
        # If TAG had no `:` (e.g. just "python"), TAG%%:* == TAG and TAG##:* == TAG, producing TAG:TAG@...
        # In that case fall back to the form digest_repo@digest.
        case "$TAG" in
            *:*)  : ;;
            *)    PINNED="${TAG}@${DIG##*@}" ;;
        esac
        "$LIB/config.sh" set "$d" '.base_image' "$PINNED" >/dev/null
        info "pinned base image: $PINNED"
        info "next deploy will rebuild from this exact digest"
        ;;

    # ---- Telegram bot --------------------------------------------------
    bot)
        "$LIB/bot.sh" "$@" ;;

    # ---- maintenance ---------------------------------------------------
    update)
        "$LIB/update.sh" "$@" ;;

    check-updates)
        sub="${1:-check}"; shift || true
        case "$sub" in
            check|install-timer|uninstall-timer|status|help|-h|--help|"")
                "$LIB/check-updates.sh" "$sub" "$@" ;;
            *) err "unknown check-updates sub: $sub"; echo "Try: nelly help check-updates" >&2; exit 2 ;;
        esac ;;

    *)
        err "unknown command: $cmd"
        echo "Try: nelly help" >&2
        exit 2
        ;;
esac
